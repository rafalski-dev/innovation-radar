// Prisma schema: https://pris.ly/d/prisma-schema
// Po każdej zmianie: npm run db:push

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Użytkownicy (Better Auth) ----------

enum UserRole {
  USER
  OFFICIAL
  BUSINESS
}

model User {
  id                     String                  @id
  name                   String
  firstName              String?
  lastName               String?
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  role                   UserRole                @default(USER)
  organization           String?
  position               String?
  interests              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  businesses             Business[]
  businessMemberships    BusinessMember[]
  searches               Search[]
  phraseGenerations      PhraseGeneration[]
  descriptionGenerations DescriptionGeneration[]
  agentRuns              AgentRun[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Biznesy ----------
// Biznes należy do użytkownika; do niego będą przypisywane potrzeby i zapytania.

model Business {
  id          String           @id @default(cuid())
  name        String
  nip         String?          @unique // NIP pilnuje, żeby ta sama firma nie została dodana dwa razy
  industry    String?
  street      String?
  postalCode  String?
  city        String?
  website     String?
  description String?
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  needs       Need[]
  members     BusinessMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([ownerId])
}

// ---------- Potrzeby ----------
// Projekt należy do biznesu: tytuł + opis (na razie jedno pole). Podstawa zapytań do agenta.

model Need {
  id              String     @id @default(cuid())
  title           String
  expectedOutcome String? // wycofane z formularza (na razie jeden opis); stare wpisy zachowują wartość
  description     String // opis projektu: używany przez wyszukiwarkę i generowanie fraz
  linkUrls        String[] @default([]) // opcjonalne linki do materiałów (do 3)
  files           NeedFile[]
  searches        Search[]
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
}

// Opcjonalne pliki PDF przy potrzebie (do NEED_FILES_MAX). Sama zawartość leży w Cloudflare R2 pod kluczem `key`;
// pobieranie przez /api/project-files/[fileId] (sprawdza dostęp i przekierowuje na podpisany adres).
model NeedFile {
  id        String   @id @default(cuid())
  needId    String
  need      Need     @relation(fields: [needId], references: [id], onDelete: Cascade)
  fileName  String
  size      Int
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([needId])
}

// Osoby przypisane do organizacji. Właściciel (Business.ownerId) jest jej administratorem
// i nie ma tu wpisu; członkowie widzą organizację i zarządzają jej potrzebami.
model BusinessMember {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([businessId, userId])
  @@index([userId])
}

// ---------- Wyszukiwania ----------
// Historia zapytań użytkownika do agenta. Projekt jest opcjonalny (po jego usunięciu wpis zostaje).
// Wyniki agenta dojdą w osobnej tabeli, gdy agent powstanie.

model Search {
  id           String         @id @default(cuid())
  query        String
  phrases      Json? // zatwierdzone frazy: lista 3-5 tekstów (po polsku)
  status       SearchStatus   @default(DRAFT)
  error        String?
  phrasesKey   String? // hash projektu + fraz: ten sam klucz w ciągu 7 dni = wynik z cache, bez kosztu
  startedAt    DateTime? // ustawiane tylko przy prawdziwym uruchomieniu agenta (limit na użytkownika)
  webSearches  Int?
  inputTokens  Int?
  outputTokens Int?
  results      SearchResult[]
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  needId       String?
  need         Need?          @relation(fields: [needId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([needId])
}

// Licznik generowań fraz przez AI: służy do limitu na użytkownika (koszt API), nie do historii.
model PhraseGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum SearchStatus {
  DRAFT
  RUNNING
  DONE
  FAILED
}

// Kandydat znaleziony przez agenta (zawsze z linkiem do źródła).
model SearchResult {
  id           String  @id @default(cuid())
  searchId     String
  search       Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  summary      String
  organization String?
  sourceName   String
  sourceUrl    String
  why          String

  @@index([searchId])
}

// Licznik uruchomień agenta (limit na użytkownika; sam wynik zapisuje się dopiero po zatwierdzeniu).
model AgentRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Licznik generowań rozszerzonego opisu projektu (limit na użytkownika, kontrola kosztów API).
model DescriptionGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
