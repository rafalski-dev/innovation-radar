// Prisma schema: https://pris.ly/d/prisma-schema
// Po każdej zmianie: npm run db:push

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Użytkownicy (Better Auth) ----------

enum UserRole {
  USER
  ADMIN // administrator Horyzontu (panel /dashboard/admin)
}

model User {
  id                     String                  @id
  name                   String
  firstName              String?
  lastName               String?
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  role                   UserRole                @default(USER)
  position               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  businesses             Business[]
  businessMemberships    BusinessMember[]
  searches               Search[]
  phraseGenerations      PhraseGeneration[]
  descriptionGenerations DescriptionGeneration[]
  agentRuns              AgentRun[]
  authoredProjects          Project[]                  @relation("ProjectAuthor")
  feedback                  Feedback[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Biznesy ----------
// Biznes należy do użytkownika; do niego będą przypisywane potrzeby i zapytania.

model Business {
  id          String           @id @default(cuid())
  name        String
  nip         String?          @unique // NIP pilnuje, żeby ta sama firma nie została dodana dwa razy
  industry    String?
  street      String?
  postalCode  String?
  city        String?
  website     String?
  description String?
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects       Project[]
  members     BusinessMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([ownerId])
}

// ---------- Potrzeby ----------
// Projekt należy do biznesu: tytuł + opis (na razie jedno pole). Podstawa zapytań do agenta.

model Project {
  id              String     @id @default(cuid())
  title           String
  description     String // opis projektu: używany przez wyszukiwarkę i generowanie fraz
  linkUrls        String[]   @default([]) // opcjonalne linki do materiałów (do 3)
  sentAt          DateTime? // raport wysłany do członków organizacji: projekt zamknięty do edycji
  files           ProjectFile[]
  searches        Search[]
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId        String? // autor projektu (null = stare wpisy: wtedy pokazujemy właściciela organizacji)
  author          User?      @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
  @@index([authorId])
}

// Opcjonalne pliki PDF przy potrzebie (do PROJECT_FILES_MAX). Sama zawartość leży w Cloudflare R2 pod kluczem `key`;
// pobieranie przez /api/project-files/[fileId] (sprawdza dostęp i przekierowuje na podpisany adres).
model ProjectFile {
  id        String   @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  size      Int
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Osoby przypisane do organizacji. Właściciel (Business.ownerId) jest jej administratorem
// i nie ma tu wpisu; członkowie widzą organizację i zarządzają jej potrzebami.
model BusinessMember {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([businessId, userId])
  @@index([userId])
}

// ---------- Wyszukiwania ----------
// Historia zapytań użytkownika do agenta. Projekt jest opcjonalny (po jego usunięciu wpis zostaje).
// Wyniki agenta dojdą w osobnej tabeli, gdy agent powstanie.

model Search {
  id           String         @id @default(cuid())
  title        String? // nazwa aspektu nadana przez użytkownika (stare wpisy jej nie mają)
  query        String
  phrases      Json? // zatwierdzone frazy: lista 3-5 tekstów (po polsku)
  number       Int            @default(0) // numer aspektu w projekcie (0 = stare wpisy bez numeru)
  status       SearchStatus   @default(DRAFT)
  error        String?
  phrasesKey   String? // hash projektu + fraz: ten sam klucz w ciągu 7 dni = wynik z cache, bez kosztu
  startedAt    DateTime? // ustawiane tylko przy prawdziwym uruchomieniu agenta (limit na użytkownika)
  webSearches  Int?
  inputTokens  Int?
  outputTokens Int?
  results      SearchResult[]
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([projectId])
}

// Licznik generowań fraz przez AI: służy do limitu na użytkownika (koszt API), nie do historii.
model PhraseGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum SearchStatus {
  DRAFT
  RUNNING
  DONE
  FAILED
}

// Kandydat znaleziony przez agenta (zawsze z linkiem do źródła).
model SearchResult {
  id           String  @id @default(cuid())
  searchId     String
  search       Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  summary      String
  organization String?
  sourceName   String
  sourceUrl    String
  why          String
  trl          Int? // skala gotowości technologicznej 1-9 (null = nie da się ocenić ze źródła)

  @@index([searchId])
}

// Licznik uruchomień agenta (limit na użytkownika; sam wynik zapisuje się dopiero po zatwierdzeniu).
model AgentRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Licznik generowań rozszerzonego opisu projektu (limit na użytkownika, kontrola kosztów API).
model DescriptionGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------- Panel administratora Horyzontu ----------

// Źródła, w których może szukać agent (admin dodaje i edytuje; użytkownik wybiera do 2).
model Source {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  domain      String
  description String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Czarna lista e-maili: pełny adres albo domena z "@" (np. @spam.com). Blokuje rejestrację.
model BlockedEmail {
  id        String   @id @default(cuid())
  pattern   String   @unique
  createdAt DateTime @default(now())
}

// Czarna lista tematów: fraza w tytule/opisie projektu lub frazach aspektu blokuje zapis.
model BlockedTopic {
  id        String   @id @default(cuid())
  phrase    String   @unique
  createdAt DateTime @default(now())
}

// Ustawienia admina (klucz-wartość): dodatkowe instrukcje do promptów, limity.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Pomoc ----------

enum FeedbackType {
  RADAR_PROBLEM // zgłoszenie problemu z Horyzontem
  SOURCE_PROBLEM // zgłoszenie problemu ze źródłem
  CHANGE_PROPOSAL // propozycja zmiany
}

// Zgłoszenia z przycisku „Pomoc” (dostępnego na każdej stronie, także bez logowania).
model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  subject   String? // np. nazwa źródła przy zgłoszeniu problemu ze źródłem
  message   String
  email     String? // opcjonalny kontakt (przy zalogowanym: jego adres)
  pageUrl   String
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([createdAt])
}
