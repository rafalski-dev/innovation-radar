{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma db seed*)",
      "Bash(npx prisma validate*)",
      "Bash(npx tsc *)",
      "Bash(npx shadcn add *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./src/generated/**)",
      "Read(./package-lock.json)",
      "Read(./.next/**)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run -s typecheck 1>&2 || exit 2",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
